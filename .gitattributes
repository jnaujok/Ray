* text=auto eol=lf

# Visual C++ 6 will not load project/workspace files without CRLF; cmd.exe wants CRLF too.
*.dsp text eol=crlf
*.dsw text eol=crlf
*.clw text eol=crlf
*.bat text eol=crlf

# Original, untouched historical files
/legacy/** -text
/help/** -text

# Scene files: the 1997 ones are binary, the current ones JSON text.
*.ray text eol=lf
/scenes/1997/*.ray binary

# Binary assets
*.raw binary
*.out binary
*.lib binary
*.bmp binary
*.ico binary

# Reference renders and other archives
*.gz binary
