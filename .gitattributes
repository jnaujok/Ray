* text=auto eol=lf

# Visual C++ 6 will not load project/workspace files without CRLF; cmd.exe wants CRLF too.
*.dsp text eol=crlf
*.dsw text eol=crlf
*.clw text eol=crlf
*.bat text eol=crlf

# Original, untouched historical files
/legacy/** -text
/help/** -text

# Scene files are JSON text.
*.ray text eol=lf

# Binary assets
*.raw binary
*.out binary
*.lib binary
*.bmp binary
*.ico binary

# Reference renders and other archives
*.gz binary

# Model files: STL is binary (or, rarely, ASCII kept byte for byte); OBJ is text.
*.stl binary
*.obj text eol=lf

# Fonts
*.ttf binary
*.otf binary
