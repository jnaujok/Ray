IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "Scene &Hierarchy",            ID_VIEW_SCENE_TREE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Ray...",               ID_APP_ABOUT
    END
END

IDR_RAYTYPE MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "Scene &Hierarchy",            ID_VIEW_SCENE_TREE
    END
    POPUP "&Render"
    BEGIN
        MENUITEM "&Ray Trace",                  IDC_RENDER_RAY_TRACE
        MENUITEM "&Kill Trace",                 ID_RENDER_KILL_TRACE
    END
    POPUP "&Objects"
    BEGIN
        POPUP "&Add"
        BEGIN
            MENUITEM "&Sphere",                     ID_OBJECT_ADD_SPHERE
            MENUITEM "&Plane",                      ID_OBJECT_ADD_PLANE
            MENUITEM SEPARATOR
            MENUITEM "&Triangle",                   ID_OBJECTS_ADD_TRIANGLE
            , GRAYED
            MENUITEM "Sm&ooth Triangle",            ID_OBJECTS_ADD_SMOOTH_TRIANGLE
            , GRAYED
            MENUITEM "Triangular &Mesh",            ID_OBJECTS_ADD_TRIANGULAR_MESH
            , GRAYED
            MENUITEM "Pol&ygonal Mesh",             ID_OBJECTS_ADD_POLYGONAL_MESH
            , GRAYED
        END
        MENUITEM "&Delete",                     ID_OBJECT_DELETE
    END
    POPUP "&Lights"
    BEGIN
        POPUP "&Add"
        BEGIN
            MENUITEM "&Point Light",                ID_LIGHT_ADD_POINT_LIGHT
            MENUITEM SEPARATOR
            MENUITEM "&Spot Light",                 ID_ADD_LIGHT_SPOT_LIGHT
            , GRAYED
            MENUITEM "&Area Light",                 ID_LIGHT_ADD_AREA_LIGHT
            , GRAYED
            MENUITEM "Sp&herical Light",            ID_LIGHT_ADD_SPHERICAL
            , GRAYED
        END
        MENUITEM "&Delete",                     ID_LIGHT_DELETE
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&New Window",                 ID_WINDOW_NEW
        MENUITEM "&Cascade",                    ID_WINDOW_CASCADE
        MENUITEM "&Tile",                       ID_WINDOW_TILE_HORZ
        MENUITEM "&Arrange Icons",              ID_WINDOW_ARRANGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Ray...",               ID_APP_ABOUT
    END
END

