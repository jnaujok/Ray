{
    "format": "Ray scene",
    "version": 3,
    "settings": {
        "imageWidth": 640,
        "imageHeight": 480,
        "imageFile": "ray.out",
        "colorDepth": 8,
        "maximumDepth": 16,
        "depthThreshold": 0.01
    },
    "background": [1.0, 1.0, 1.0],
    "camera": {
        "position": [-2.0, 1.5, -7.0],
        "lookAt": [0.0, 0.0, 1.0],
        "up": [0.0, 1.0, 0.0],
        "verticalAngle": 30.0,
        "horizontalAngle": 40.0,
        "aspectRatio": 1.333333,
        "sampler": "none",
        "colorModel": "clip"
    },
    "objects": [
        {
            "type": "sphere",
            "center": [0.0, 0.0, 0.0],
            "radius": 1.0,
            "color": [0.5, 0.5, 0.5],
            "materials": [
                {
                    "type": "specular",
                    "influence": 0.8,
                    "color": [0.794922, 0.726563, 0.5],
                    "power": 0.85,
                    "indexOfRefraction": 1.985,
                    "materialHighlight": true
                },
                {
                    "type": "diffuse",
                    "influence": 1.0,
                    "color": [0.855469, 0.720703, 0.375],
                    "diffuseCast": false
                }
            ]
        },
        {
            "type": "plane",
            "position": [0.0, 0.0, -1.0],
            "normal": [0.0, 1.0, 0.0],
            "color": [0.5, 0.5, 0.5],
            "materials": [
                {
                    "type": "diffuse",
                    "influence": 1.0,
                    "color": [0.353516, 0.5, 0.5],
                    "diffuseCast": false
                },
                {
                    "type": "reflective",
                    "influence": 0.3,
                    "color": [0.904297, 0.886719, 0.996094],
                    "diffuseReflectivity": 0.0,
                    "filterReflection": true
                }
            ]
        }
    ],
    "lights": [
        {
            "type": "point",
            "position": [-10.0, 10.0, -10.0],
            "color": [1.0, 1.0, 1.0]
        }
    ]
}
