{
    "format": "Ray scene",
    "version": 3,
    "settings": {
        "imageWidth": 640,
        "imageHeight": 480,
        "imageFile": "ray.out",
        "colorDepth": 8,
        "maximumDepth": 15,
        "depthThreshold": 0.01
    },
    "background": [1.0, 1.0, 1.0],
    "camera": {
        "position": [0.0, 0.0, -10.0],
        "lookAt": [0.0, 0.0, 0.0],
        "up": [0.0, 1.0, 0.0],
        "verticalAngle": 30.0,
        "horizontalAngle": 40.0,
        "aspectRatio": 1.333333,
        "sampler": "none",
        "colorModel": "clip"
    },
    "objects": [
        {
            "type": "sphere",
            "center": [0.0, 0.0, 0.0],
            "radius": 1.0,
            "color": [0.5, 0.5, 0.5],
            "materials": [
                {
                    "type": "specular",
                    "influence": 1.0,
                    "color": [0.996094, 0.916016, 0.757813],
                    "power": 0.55,
                    "indexOfRefraction": 3.9,
                    "materialHighlight": true
                }
            ]
        }
    ],
    "lights": [
        {
            "type": "point",
            "position": [-10.0, 10.0, -10.0],
            "color": [1.0, 1.0, 1.0]
        }
    ]
}
